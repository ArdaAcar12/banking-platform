# Backend uygulama yapılandırması
# Bu dosya örnektir. Kendi değerlerinizi girerek .env dosyasını oluşturun.
# .env dosyası asla sürüm kontrolüne commit edilmemelidir (.gitignore dışında tutulur).

# Uygulama
SPRING_APPLICATION_NAME=banking-platform
SERVER_PORT=8080

# Veritabanı (PostgreSQL)
POSTGRES_USER=banking
POSTGRES_PASSWORD=changeme
POSTGRES_DB=banking_platform
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/banking_platform
SPRING_DATASOURCE_USERNAME=banking
SPRING_DATASOURCE_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Redis
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# MailHog (e-posta test)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Güvenlik / JWT (örnek, production'da güçlü bir değer girin)
JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRATION=86400000
